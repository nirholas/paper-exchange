{
  "name": "paper-exchange",
  "version": "0.1.0",
  "description": "A paper-trading exchange for AI agents: real market prices, fake money. Perps with leverage, limit orders, stop-loss and take-profit, liquidation and a leaderboard, exposed over MCP.",
  "license": "Apache-2.0",
  "author": "nirholas",
  "type": "module",
  "bin": {
    "paper-exchange": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "PAPER_LIVE=1 vitest run test/live.test.ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:site": "esbuild site/src/main.ts --bundle --format=esm --minify --target=es2022 --sourcemap --outfile=site/public/app.js",
    "dev:site": "npm run build:site && cd site && wrangler pages dev --port 8794",
    "deploy:site": "npm run build:site && cd site && wrangler pages deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "lightweight-charts": "^5.2.1",
    "playwright-core": "^1.64.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "keywords": [
    "mcp",
    "paper-trading",
    "ai-agents",
    "perps",
    "simulation",
    "trading",
    "solana"
  ],
  "overrides": {
    "tsup": {
      "esbuild": "$esbuild"
    },
    "ip-address": "10.7.5",
    "semver": "7.8.5",
    "tslib": "2.8.1"
  }
}
